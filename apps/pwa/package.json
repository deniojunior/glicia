{
  "name": "@glicia/pwa",
  "version": "0.14.0-beta.0",
  "private": true,
  "description": "PWA mobile-first da Glicia.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start --workdir ../..",
    "supabase:stop": "supabase stop --workdir ../..",
    "supabase:status": "supabase status --workdir ../..",
    "supabase:reset": "supabase db reset --local --workdir ../..",
    "supabase:test": "supabase test db --workdir ../..",
    "staging:check": "supabase migration list --linked --workdir ../.. && supabase db push --dry-run --linked --workdir ../..",
    "staging:deploy:db": "supabase db push --linked --workdir ../..",
    "staging:deploy:functions": "supabase functions deploy --workdir ../..",
    "staging:deploy:config": "supabase config push --workdir ../..",
    "staging:advisors": "supabase db advisors --linked --type all --level warn --workdir ../.."
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.6",
    "@supabase/supabase-js": "2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.12.0",
    "jsdom": "26.1.0",
    "supabase": "2.116.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1"
  }
}
