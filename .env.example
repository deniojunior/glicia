# Glicia — variáveis de ambiente (exemplo)
#
# IMPORTANTE: A Fase 1 (MVP Local) é 100% offline e NÃO usa nenhuma destas
# variáveis em runtime. Elas existem apenas como referência para as fases
# futuras (WhatsApp, OpenAI, Supabase, áudio, Google Sheets).
#
# NUNCA coloque segredos reais neste arquivo. Copie para `.env` e preencha
# localmente (o `.env` é ignorado pelo git).

# --- Fase 1 (opcional) ---
# Caminho do arquivo SQLite local. Vazio/omisso usa o padrão da aplicação.
GLICIA_DB_PATH=

# Seleciona a implementação do Interpreter.
# "openai" habilita o OpenAiInterpreter (Responses API + JSON Schema).
# Vazio/qualquer outro valor mantém o padrão offline (MockInterpreter local).
GLICIA_INTERPRETER=

# --- Fase futura: OpenAI (Interpreter) ---
# Chave da API OpenAI (segredo server-side; nunca commitar valor real).
OPENAI_API_KEY=
# Modelo usado pelo OpenAiInterpreter. Vazio usa o padrão "gpt-4o-mini".
OPENAI_MODEL=

# --- Fase futura: WhatsApp Cloud API (Channel) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Fase futura: Supabase (Repository) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase futura: Google Sheets (Sink) ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
